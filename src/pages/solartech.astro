---
import '../styles/global.css' 
import { Image } from 'astro:assets'
import cardImage from './_screenshot.png'
import solarPanel from  './_solar_panel.jpg'
import cables from './_cables.jpg'
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solar Tech System - Powering Tomorrow's World</title>
     <meta name="description" content="Revolutionary solar technology solutions for homes and businesses. Harness the power of the sun with our cutting-edge solar systems.">
     <meta name="keywords" content="solar energy, solar panels, solar installation, renewable energy, Botswana, solar systems, off-grid solar" />
     <script type="application/ld+json">
     {
       "@context": "https://schema.org",
       "@type": "EnergyService",
       "name": "Solar Tech System",
       "description": "Revolutionary solar technology solutions for homes and businesses in Botswana.",
       "address": {
         "@type": "PostalAddress",
         "addressCountry": "Botswana"
       },
       "telephone": "+267 71257777",
       "serviceType": "Solar Energy Solutions"
     }
     </script>
   </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <header class="fixed top-0 w-full bg-white/90 backdrop-blur-md z-50 border-b border-gray-200">
      <nav class="container mx-auto p-4  flex">
         <div class="flex items-center space-x-8">
           <a href="/thinktech-botswana" class="text-gray-700 hover:text-yellow-600 transition-colors">Home</a>
           <a href="#services" class="text-gray-700 hover:text-yellow-600 transition-colors">Our Services</a>
           <a href="#about" class="text-gray-700 hover:text-yellow-600 transition-colors">About Us</a>
           <a href="#contact" class="text-gray-700 hover:text-yellow-600 transition-colors">Contact Us</a>
            <button id="get-quote-header" class="bg-gradient-to-r from-green-500 to-green-600 text-white px-6 py-2 rounded-full hover:shadow-lg transition-all">
              Get Quote
            </button>
         </div>

        <button class="md:hidden">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        </div>
      </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="min-h-screen bg-[url(/thinktech-botswana/solar-logo.jpg)] bg-center bg-no-repeat bg-white flex items-center relative overflow-hidden pt-20">
      <div class="absolute inset-0 bg-black/30"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="text-white">
            <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
              Harness the 
              <span class="bg-gradient-to-r from-yellow-300 to-orange-300 bg-clip-text text-transparent">
                Power of Tomorrow
              </span>
            </h1>
            <p class="text-xl md:text-2xl mb-8 text-gray-200 leading-relaxed">
              Revolutionary solar technology that transforms sunlight into sustainable energy for your home and business.
            </p>
             <div class="flex flex-col sm:flex-row gap-4">
               <button class="bg-white text-gray-800 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition-all hover-lift pulse-glow">
                 Start Your Solar Journey Today!
               </button>
               <p class="text-white/80 text-sm mt-2 content-center">Save on energy bills - Act now!</p>
             </div>
          </div>

          <div class="relative">
            <div class="floating">
              <div class="w-96 h-96 mx-auto relative">
                <div class="absolute inset-0 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-full opacity-20 blur-3xl"></div>
                <div class="relative bg-white/10 backdrop-blur-lg rounded-3xl p-8 border border-white/20">
                  <div class="grid grid-cols-3 gap-4">
                    <div class="bg-yellow-400 h-12 rounded-lg opacity-80"></div>
                    <div class="bg-orange-400 h-12 rounded-lg opacity-90"></div>
                    <div class="bg-yellow-500 h-12 rounded-lg opacity-85"></div>
                    <div class="bg-orange-500 h-12 rounded-lg opacity-75"></div>
                    <div class="bg-yellow-600 h-12 rounded-lg opacity-95"></div>
                    <div class="bg-orange-400 h-12 rounded-lg opacity-80"></div>
                    <div class="bg-yellow-500 h-12 rounded-lg opacity-90"></div>
                    <div class="bg-orange-600 h-12 rounded-lg opacity-85"></div>
                    <div class="bg-yellow-400 h-12 rounded-lg opacity-80"></div>
                  </div>
                  <div class="mt-6 text-center text-white">
                    <div class="text-3xl font-bold">99.2%</div>
                    <div class="text-sm opacity-80">Efficiency Rate</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 text-white animate-bounce">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" >
      <div class="flex bg-[url(/thinktech-botswana/solarImage.png)] bg-cover">
        <div class="items-center flex-1/2 bg-white py-16 px-4 rounded-r-[100px]">
          <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-800">
            Leading the Solar Revolution
          </h2>
          <p class="text-xl text-gray-600 mb-6 leading-relaxed">
            Solartech Energy Systems is a multi-discipline company that specialises
            in Solar Technolgy. Solartech Energy Systems delivers high quality and reliable
            Solar Energy services, construction and supplies services to different clients and
            customers, ranging from individuals to corporations and government sectors at all
            times.
          </p>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
Our <span class="font-bold">MISSION</span> is to be a globalised producer of clean energy products.
          </p>
           <p class="text-lg text-gray-600 mb-8 leading-relaxed">
             Our <span class="font-bold">VISION</span> is to be the first choice clean energy & reliable power producer.
           </p>

           <!-- Stats Section -->
           <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
             <div class="text-center">
               <div class="text-4xl font-bold text-green-600">2000+</div>
               <div class="text-gray-600">Systems Installed</div>
             </div>
             <div class="text-center">
               <div class="text-4xl font-bold text-green-600">50%</div>
               <div class="text-gray-600">Average Savings</div>
             </div>
             <div class="text-center">
               <div class="text-4xl font-bold text-green-600">25</div>
               <div class="text-gray-600">Years Warranty</div>
             </div>
             <div class="text-center">
               <div class="text-4xl font-bold text-green-600">ROI</div>
               <div class="text-gray-600">3-5 Years</div>
             </div>
           </div>
         </div>
         <div class="flex-1/3">
         </div>
       </div>
     </section>

     <!-- Services -->
     <section id="services" class="py-20">
       <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-800 text-center">
         What we offer?
       </h2>
        <div class="container mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                AC/DC Solar Pump System
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We design, supply, and install AC and DC solar-powered water pumping systems suitable for single-phase and three-phase applications. Our solutions are ideal for boreholes, irrigation, livestock watering, and community water supply projects. The systems are designed based on borehole depth, water demand, pump capacity, and solar availability to ensure efficient and reliable performance with minimal operating costs.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Home / Farm Off grid System
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We provide complete off-grid solar power systems for homes and farms that operate independently from the national grid. These systems are capable of powering essential and heavy-duty appliances such as lighting, televisions, refrigerators, freezers, computers, phone chargers, water pumps, electric fences, and selected farm equipment, depending on system size. Each system is carefully designed to meet daily energy needs and ensure reliable power supply.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Solar Equipment Sales
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>Solartech Energy Systems supplies high-quality solar equipment, including solar panels, inverters (single-phase and three-phase), batteries, charge controllers, mounting structures, and all required accessories. We assist customers in selecting equipment that matches their power requirements and long-term energy goals.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Solar Panel Installation
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>Our professional installation services ensure correct mounting, optimal panel orientation, and safe electrical connections. We follow industry best practices to maximize energy production, system safety, and durability under local environmental conditions.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Solar System Design
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We offer customized solar system designs based on detailed site assessments, energy usage analysis, and future expansion needs. Our designs focus on efficiency, reliability, and cost-effectiveness for residential, agricultural, and commercial applications.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Water Tests & Soil Tests
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We conduct water quality and soil condition tests to support the proper selection and performance of solar pumping and irrigation systems. These tests help prevent equipment damage and ensure suitability for agricultural and domestic use.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Net Metering Setup
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We assist clients with the complete net metering process, including system sizing, documentation, installation, and compliance. This allows customers to feed excess solar power back into the grid and reduce electricity costs.</p>
                </div>
              </h3>
            </div>
            <div class="relative bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer h-20 overflow-visible">
              <h3 class="service-title text-xl font-semibold mb-2 text-gray-800">
                Solar System Maintenance
                <div class="service-overlay absolute top-12 left-0 right-0 bg-white p-4 rounded-b-lg shadow-lg text-gray-600 text-sm opacity-0 transition-opacity duration-300 z-50">
                  <p>We provide comprehensive maintenance services, including system inspections, panel cleaning, performance monitoring, fault diagnosis, and repairs. Regular maintenance ensures optimal system operation, extends equipment lifespan, and protects your investment.</p>
                </div>
              </h3>
            </div>
          </div>
        </div>
     </section>

    <!-- Features Section -->
    <section id="products" class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-800">
            Next-Generation Solar Solutions
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Experience the future of renewable energy with our cutting-edge solar technology designed for maximum efficiency and sustainability.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Card product 1 -->
          <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-3xl shadow-lg hover-lift">
            <Image src={solarPanel} alt="Card product" class="rounded-t-2xl w-full max-h-80"/>
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-4 text-gray-800 text-center">Solar Panels and Batteries</h3>
              <ul class="text-gray-600 list-disc">
                <li>Renesys Solar Panels Grade A</li>
                <li>Lithium Ion ( Freedom Won )</li>
                <li>Lead Acid</li>
                <li>Victron MPPT</li>
              </ul>
            </div>
          </div>

          <!-- Card product 2 -->
          <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-3xl shadow-lg hover-lift">
            <Image src={cables} alt="Card product" class="rounded-t-2xl w-full max-h-80"/>
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-4 text-gray-800 text-center">System Accesories</h3>
              <ul class="text-gray-600 list-disc">
                <li> DC Cabling and Components (some included in combiner boxes)</li>
                <li>Victron Energy Data Cables</li>
                <li>Online Monitoring</li>
                <li>Victron BatteryChargers</li>
              </ul>
            </div>
          </div>

          <!-- Card product 3 -->
          <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-3xl shadow-lg hover-lift">
            <Image src={cardImage} alt="Card product" class="rounded-t-2xl w-full max-h-80"/>
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-4 text-gray-800 text-center">Inverters</h3>
              <ul class="text-gray-600 list-disc">
                <li>Off- Grid (Victron)</li>
                <li>Grid- Tie (Fronius Inverter)</li>
                <li>Hybrid (ATESS)</li>
              </ul>
            </div>
          </div>
         </div>
       </div>
     </section>

     <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-lime-500 to-green-600">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          Ready to Go Solar?
        </h2>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Join thousands of satisfied customers who have made the switch to clean, renewable energy. Get your free consultation today.
        </p>
         <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button id="get-quote-cta" class="bg-white text-gray-800 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition-all hover-lift">
              Get Your FREE Quote Now!
            </button>
           <p class="text-white/80 text-sm mt-2">Special discount for first 10 customers this month</p>
           <button class="border-2 border-white text-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-gray-800 transition-all">
             Call Now: (+267) 71257777 / 72622859
           </button>
         </div>
      </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="bg-gray-900 text-white py-16">
      <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-8">
          <div>
            <div class="flex items-center space-x-2 mb-6">
              <span class="text-xl font-bold">Solar Tech System</span>
            </div>
            <p class="text-gray-400 leading-relaxed">
              Powering a sustainable future with innovative solar technology solutions.
            </p>
          </div>

          <div>
            <h3 class="text-lg font-semibold mb-4">Contact Info</h3>
            <div class="space-y-2 text-gray-400">
              <p>123 Solar Street</p>
              <p>Green City, GC 12345</p>
              <p>(555) 123-SOLAR</p>
              <p>info@solartech.com</p>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-800 mt-12 pt-8 text-center text-gray-400">
          <p>&copy; 2025 Solar Tech System. All rights reserved.</p>
        </div>
      </div>
     </footer>

     <!-- Quote Modal -->
     <div id="quote-modal" class="hidden fixed flex inset-0 bg-black/40 items-center justify-center z-50">
       <div class="bg-white rounded-lg p-6 w-full max-w-md mx-4">
         <h3 class="text-2xl font-bold mb-6 text-gray-800">Get Your Quote</h3>
         <form id="quote-form">
           <div class="mb-4">
             <label class="block text-gray-700 font-medium mb-2">Borehole Depth</label>
             <input type="number" name="depth" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Enter depth in meters">
           </div>
           <div class="mb-4">
             <label class="block text-gray-700 font-medium mb-2">Borehole Yield</label>
             <input type="number" name="yield" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Enter yield in liters per minute">
           </div>
           <div class="mb-4">
             <label class="block text-gray-700 font-medium mb-2">Borehole Location</label>
             <input type="text" name="location" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Enter location">
           </div>
           <div class="mb-6">
             <label class="block text-gray-700 font-medium mb-2">Preferred System</label>
             <select name="system" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
               <option value="">Select preferred system</option>
               <option value="AC/DC">AC/DC</option>
               <option value="DC">DC</option>
               <option value="AC">AC</option>
             </select>
           </div>
           <div class="flex justify-end space-x-3">
             <button type="button" id="close-modal" class="px-6 py-2 text-gray-600 hover:text-gray-800 transition-colors">Cancel</button>
             <button type="submit" class="px-6 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-full hover:shadow-lg transition-all">Submit Quote Request</button>
           </div>
         </form>
       </div>
     </div>

      <script is:inline>
   // Smooth scrolling for navigation links
   document.querySelectorAll('a[href^="#"]').forEach(anchor => {
     anchor.addEventListener('click', function (e) {
       e.preventDefault();
       const target = document.querySelector(this.hash);
       if (target) {
         target.scrollIntoView({
           behavior: 'smooth',
           block: 'start'
         });
       }
     });
   });

    // Add scroll effect to header
    window.addEventListener('scroll', () => {
      const header = document.querySelector('header');
      if (header) {
        if (window.scrollY > 100) {
          header.classList.add('shadow-lg');
        } else {
          header.classList.remove('shadow-lg');
        }
      }
    });

    // Service overlay functionality
    document.querySelectorAll('.service-title').forEach(title => {
      title.addEventListener('mouseenter', () => {
        const overlay = title.querySelector('.service-overlay');
        if (overlay) overlay.classList.add('opacity-100');
      });
      title.addEventListener('mouseleave', () => {
        const overlay = title.querySelector('.service-overlay');
        if (overlay) overlay.classList.remove('opacity-100');
      });
    });

    // Modal functionality
    const modal = document.getElementById('quote-modal');
    const closeBtn = document.getElementById('close-modal');
    const form = document.getElementById('quote-form');
    const getQuoteHeader = document.getElementById('get-quote-header');
    const getQuoteCta = document.getElementById('get-quote-cta');

    // Show modal on button clicks
    if (getQuoteHeader) {
      getQuoteHeader.addEventListener('click', () => {
        if (modal) modal.classList.remove('hidden');
      });
    }

    if (getQuoteCta) {
      getQuoteCta.addEventListener('click', () => {
        if (modal) modal.classList.remove('hidden');
      });
    }

    // Close modal
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        if (modal) modal.classList.add('hidden');
      });
    }

    // Close modal when clicking outside
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }

    // Handle form submission
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const data = {
          depth: formData.get('depth'),
          yield: formData.get('yield'),
          location: formData.get('location'),
          system: formData.get('system')
        };
        alert(`Quote request submitted!\nDepth: ${data.depth}\nYield: ${data.yield}\nLocation: ${data.location}\nSystem: ${data.system}`);
        form.reset();
        if (modal) modal.classList.add('hidden');
      });
    }
      </script>
  </body>
</html>
